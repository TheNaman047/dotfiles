{
  "cleanupPeriodDays": 30,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "$HOME"
    ]
  },
  "model": "opus",
  "disableBundledSkills": false,
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "bashOutputMaxChars": 8000,
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true,
    "typesafe@typesafe-ai": true,
    "vidopix-mcp@vidopix-marketplace": true
  },
  "extraKnownMarketplaces": {
    "coverstar-agents": {
      "source": {
        "source": "github",
        "repo": "noraeinc/coverstar-agents"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "vidopix-marketplace": {
      "source": {
        "source": "github",
        "repo": "vidopix/claude-marketplace"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "promptCacheTtl": "1h",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "maxEffortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "custom:kanagawa-wave",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "bgIsolation": "none",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh clear", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh working", "timeout": 5 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh waiting", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh working", "timeout": 5 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh waiting", "timeout": 5 }]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh idle", "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh done", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/scripts/claude-status.sh clear", "timeout": 5 }] }
    ]
  }
}
