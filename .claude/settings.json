{
  "cleanupPeriodDays": 30,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "$HOME"
    ]
  },
  "model": "sonnet",
  "disableBundledSkills": false,
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "bashOutputMaxChars": 8000,
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "coverstar-agents": {
      "source": {
        "source": "github",
        "repo": "noraeinc/coverstar-agents"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "promptCacheTtl": "1h",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "maxEffortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "custom:kanagawa-wave",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "bgIsolation": "none"
}
